# The image only copies pyproject.toml, uv.lock, src/ and run.sh. This keeps the build
# context small and keeps secrets, challenge data and local state out of it.
.git
.gitignore
.env
.env.*
.venv
venv
data/
material-reto/
state/
output/
design-site/
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info
.DS_Store
.idea
.vscode
.vercel
.railway
